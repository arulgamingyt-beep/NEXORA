rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMemberOfCommunity(communityId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/communities/$(communityId)).data.isPublic == true
      );
    }

    function getMemberRole(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role;
    }

    function isCommunityModerator(communityId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid ||
        getMemberRole(communityId) == 'owner' ||
        getMemberRole(communityId) == 'admin' ||
        getMemberRole(communityId) == 'moderator'
      );
    }

    function getPlatformRole() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              'platformRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole
        : (request.auth.token.email == 'admin@nexora.io' ? 'super_admin' : 'none');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getPlatformRole() == 'super_admin' ||
        request.auth.token.email == 'admin@nexora.io' ||
        request.auth.token.super_admin == true
      );
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getPlatformRole() == 'admin' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'])
      );
    }

    function isPlatformModerator() {
      return isSignedIn() && (
        isPlatformAdmin() ||
        getPlatformRole() == 'moderator'
      );
    }

    function isSystemAdmin() {
      return isPlatformAdmin();
    }

    // 0. Connection Test
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId) && isValidId(userId) &&
        // Self-registered users cannot grant themselves super_admin or admin roles!
        (!('platformRole' in request.resource.data) || request.resource.data.platformRole in ['none', 'moderator']) &&
        (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == false);

      allow update: if isSignedIn() && isValidId(userId) && (
        // Super Admin can update any user's profile and roles
        isSuperAdmin() ||
        // Platform Admin can update non-platformRole fields (including suspension)
        (isPlatformAdmin() && (!('platformRole' in request.resource.data) || request.resource.data.platformRole == resource.data.platformRole)) ||
        // Normal user self-update: strictly forbidden from altering platformRole or isSuspended!
        (isUser(userId) &&
         (!('platformRole' in request.resource.data) || request.resource.data.platformRole == resource.data.platformRole) &&
         (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == resource.data.isSuspended))
      );
      allow delete: if isSuperAdmin();

      // Private settings subcollection - Protected for user only
      match /private/{docId} {
        allow read, write: if isUser(userId);
      }
    }

    // 2. Communities Collection
    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(communityId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(communityId) && (
        // Platform Admins can update any community (including suspension)
        isPlatformAdmin() ||
        // Community owner / moderator update when community is not suspended
        ((resource.data.isSuspended != true) && (
          resource.data.ownerId == request.auth.uid ||
          (isCommunityModerator(communityId) && request.resource.data.ownerId == resource.data.ownerId)
        ) &&
        (!('isSuspended' in request.resource.data) || request.resource.data.isSuspended == resource.data.isSuspended))
      );
      allow delete: if isSignedIn() && isValidId(communityId) && (
        resource.data.ownerId == request.auth.uid || isPlatformAdmin()
      );

      // 3. Community Members Subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(memberId) && (
          (request.auth.uid == memberId && (request.resource.data.role == 'member' || !('role' in request.resource.data))) ||
          isCommunityModerator(communityId)
        );
        allow update: if isCommunityModerator(communityId);
        allow delete: if isSignedIn() && (
          request.auth.uid == memberId || isCommunityModerator(communityId)
        );
      }

      // 4. Community Channels Subcollection
      match /channels/{channelId} {
        allow read: if isMemberOfCommunity(communityId);
        allow create: if isCommunityModerator(communityId) && isValidId(channelId);
        allow update: if isCommunityModerator(communityId) && isValidId(channelId);
        allow delete: if isCommunityModerator(communityId) && isValidId(channelId);

        // 5. Messages Subcollection (Transmissions)
        match /messages/{messageId} {
          allow read: if isMemberOfCommunity(communityId);

          allow create: if isMemberOfCommunity(communityId) &&
            isValidId(messageId) &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.content is string &&
            request.resource.data.content.size() <= 4000;

          // Users can edit their own message OR update reactions/pinning
          allow update: if isMemberOfCommunity(communityId) && isValidId(messageId) && (
            // Author editing own text content
            (resource.data.authorId == request.auth.uid) ||
            // Any member updating emoji reactions
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
            // Moderator pinning or updating
            isCommunityModerator(communityId)
          );

          // Author can delete their own message; Moderators/Admins/Owners can delete any message
          allow delete: if isMemberOfCommunity(communityId) && isValidId(messageId) && (
            resource.data.authorId == request.auth.uid ||
            isCommunityModerator(communityId)
          );
        }
      }
    }

    // Direct Messages & Group Conversations - Secure Authorization Boundary
    match /dm_threads/{threadId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
        threadId.matches('.*' + request.auth.uid + '.*')
      );
      allow create: if isSignedIn() && isValidId(threadId) && (
        (request.resource.data.participantIds is list && request.auth.uid in request.resource.data.participantIds) ||
        threadId.matches('.*' + request.auth.uid + '.*')
      );
      allow update: if isSignedIn() && isValidId(threadId) && (
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds) ||
        threadId.matches('.*' + request.auth.uid + '.*')
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          resource == null ||
          resource.data.authorId == request.auth.uid ||
          threadId.matches('.*' + request.auth.uid + '.*') ||
          (exists(/databases/$(database)/documents/dm_threads/$(threadId)) &&
           get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participantIds is list &&
           request.auth.uid in get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participantIds)
        );

        allow create: if isSignedIn() && isValidId(messageId) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 4000 &&
          (
            threadId.matches('.*' + request.auth.uid + '.*') ||
            (exists(/databases/$(database)/documents/dm_threads/$(threadId)) &&
             get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participantIds is list &&
             request.auth.uid in get(/databases/$(database)/documents/dm_threads/$(threadId)).data.participantIds)
          );

        allow update: if isSignedIn() && isValidId(messageId) && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy'])
        );

        allow delete: if isSignedIn() && isValidId(messageId) && resource.data.authorId == request.auth.uid;
      }
    }

    // Conversations Collection (1:1 & Group DMs)
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isSignedIn() && isValidId(convId) &&
        request.resource.data.participantIds is list &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && isValidId(convId) &&
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds);
      allow delete: if isSignedIn() && isValidId(convId) && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          resource == null ||
          resource.data.authorId == request.auth.uid ||
          (exists(/databases/$(database)/documents/conversations/$(convId)) &&
           get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds is list &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds)
        );
        allow create: if isSignedIn() && isValidId(messageId) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 4000;
        allow update: if isSignedIn() && isValidId(messageId) && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy'])
        );
        allow delete: if isSignedIn() && isValidId(messageId) && (
          resource.data.authorId == request.auth.uid ||
          (exists(/databases/$(database)/documents/conversations/$(convId)) &&
           get(/databases/$(database)/documents/conversations/$(convId)).data.ownerId == request.auth.uid)
        );
      }
    }

    // Friend Requests Collection
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(requestId) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid;
      allow update: if isSignedIn() && isValidId(requestId) && (
        (resource.data.receiverId == request.auth.uid && request.resource.data.status in ['accepted', 'rejected']) ||
        (resource.data.senderId == request.auth.uid && request.resource.data.status == 'canceled')
      );
      allow delete: if isSignedIn() && isValidId(requestId) && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // Friendships Collection
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && (
        resource == null ||
        (resource.data.userIds is list && request.auth.uid in resource.data.userIds)
      );
      allow create: if isSignedIn() && isValidId(friendshipId) &&
        request.resource.data.userIds is list &&
        request.auth.uid in request.resource.data.userIds;
      allow update: if isSignedIn() && isValidId(friendshipId) &&
        (resource.data.userIds is list && request.auth.uid in resource.data.userIds);
      allow delete: if isSignedIn() && isValidId(friendshipId) &&
        (resource.data.userIds is list && request.auth.uid in resource.data.userIds);
    }

    // Blocked Users Collection
    match /blocked_users/{blockId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.blockerId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(blockId) &&
        request.resource.data.blockerId == request.auth.uid &&
        request.resource.data.blockedId != request.auth.uid;
      allow delete: if isSignedIn() && isValidId(blockId) && resource.data.blockerId == request.auth.uid;
    }

    // Calls & Realtime Signaling Collection
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.callerId == request.auth.uid ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isSignedIn() && isValidId(callId) &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.participantIds is list &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && isValidId(callId) && (
        resource.data.callerId == request.auth.uid ||
        (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)
      );
      allow delete: if isSignedIn() && isValidId(callId) && resource.data.callerId == request.auth.uid;

      match /signaling/{signalId} {
        allow read, create: if isSignedIn() && isValidId(signalId) && (
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds
        );
      }

      match /participants/{userId} {
        allow read: if isSignedIn() && (
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds
        );
        allow write: if isSignedIn() && (
          request.auth.uid == userId ||
          (exists(/databases/$(database)/documents/calls/$(callId)) &&
           get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid)
        );
      }
    }

    // Beta Testing Feedback System
    match /beta_feedback/{feedbackId} {
      // Ordinary testers can read their own feedback; System Admins can read all feedback
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.testerId == request.auth.uid ||
        isSystemAdmin()
      );

      // Authenticated testers can submit feedback with strict schema validation
      allow create: if isSignedIn() && isValidId(feedbackId) &&
        request.resource.data.testerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 10 &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.category in ['voice_video', 'messaging', 'communities', 'auth', 'performance', 'ui_ux', 'other'] &&
        request.resource.data.severity in ['low', 'medium', 'high', 'critical'] &&
        request.resource.data.status == 'new' &&
        (!('screenshot' in request.resource.data) || request.resource.data.screenshot is string);

      // Only authorized administrators can update status and admin notes
      allow update: if isSystemAdmin() && isValidId(feedbackId) &&
        request.resource.data.status in ['new', 'reviewing', 'in_progress', 'fixed', 'closed'];

      // Only administrators can delete feedback
      allow delete: if isSystemAdmin() && isValidId(feedbackId);
    }

    // Beta Access Applications & Access Control System
    match /beta_applications/{appId} {
      // Ordinary applicants can read only their own application; System Admins can read all applications
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isSystemAdmin()
      );

      // Authenticated applicants can submit applications with strict schema validation
      // STRICT SECURITY: Status MUST be 'pending' upon creation — Users CANNOT approve themselves!
      allow create: if isSignedIn() && isValidId(appId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.status == 'pending';

      // STRICT SECURITY: Only authorized System Admins can approve or reject applications
      // Regular users are completely blocked from modifying status or approving themselves!
      allow update: if isSystemAdmin() && isValidId(appId) &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];

      // Only administrators can delete application records
      allow delete: if isSystemAdmin() && isValidId(appId);
    }

    // 17. Reports & Moderation Management System
    match /reports/{reportId} {
      // Users can read their own submitted reports; Moderators, Admins, and Super Admins can read all reports
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.reporterId == request.auth.uid ||
        isPlatformModerator()
      );

      // Authenticated users can submit a report with initial status = 'pending'
      allow create: if isSignedIn() && isValidId(reportId) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.targetType in ['user', 'message', 'community'] &&
        request.resource.data.targetId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3;

      // Only Moderators, Admins, and Super Admins can update status, assign moderation decisions, or notes
      allow update: if isPlatformModerator() && isValidId(reportId) &&
        request.resource.data.status in ['pending', 'investigating', 'resolved', 'dismissed'];

      // Only Platform Admins / Super Admins can delete reports
      allow delete: if isPlatformAdmin() && isValidId(reportId);
    }

    // 18. Administrator Security Audit Logs (Immutable Ledger)
    match /admin_audit_logs/{logId} {
      // Platform Moderators, Admins, and Super Admins can inspect the audit trail
      allow read: if isPlatformModerator();

      // Only Platform Admins and Super Admins can record audit entries
      allow create: if isPlatformAdmin() && isValidId(logId) &&
        request.resource.data.adminId == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.timestamp is string;

      // STRICT IMMUTABILITY: Audit records cannot be modified under any circumstances!
      allow update: if false;

      // Only Super Admins can purge audit records
      allow delete: if isSuperAdmin() && isValidId(logId);
    }

    // 19. Notifications Collection (Activity Center)
    match /notifications/{notificationId} {
      // Operatives can ONLY read notifications targeted directly to them
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      // Operatives can only update their own notifications (e.g. mark as read)
      allow update: if isSignedIn() && isValidId(notificationId) &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == request.auth.uid;

      // Operatives can delete their own notifications
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      // Notification creation:
      // 1. Authenticated user can trigger notification for recipient (DMs, mentions, calls, invites)
      // 2. Moderation action notifications strictly require isPlatformModerator()!
      allow create: if isSignedIn() && isValidId(notificationId) &&
        request.resource.data.recipientId is string &&
        (
          request.resource.data.senderId == request.auth.uid ||
          request.auth.uid == request.resource.data.recipientId ||
          isPlatformModerator()
        ) &&
        // Non-moderators are strictly blocked from forging 'moderation_action' notifications!
        (request.resource.data.type != 'moderation_action' || isPlatformModerator());
    }

    // 20. Notification Preferences Subcollection
    match /users/{userId}/preferences/{docId} {
      allow read, write: if isUser(userId);
    }
  }
}
