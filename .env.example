# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE
# For Cloudflare Pages, configure these in:
# Settings -> Environment Variables (Production & Preview)
# ==============================================================================

# Node.js Version for Cloudflare Pages Build Runner
NODE_VERSION="20"

# Public Application URL (Your Cloudflare Pages domain or custom domain)
VITE_APP_URL="https://your-nexora-project.pages.dev"

# Firebase Client Configuration (Standard Vite Environment Variables)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Optional WebRTC TURN Infrastructure (Defaults to Google STUN at ₹0 budget)
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Optional Gemini AI API Key
GEMINI_API_KEY=""
