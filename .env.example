# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE
# Project: nexora-a607f | Production Domain: https://nexora-a607f.web.app
# Configure in Cloudflare Pages (Settings -> Environment variables) or .env.local
# ==============================================================================

# Node.js Version for CI/CD Build Runners
NODE_VERSION="20"

# Public Application URL
VITE_APP_URL="https://nexora-a607f.web.app"

# Firebase Client Configuration (Project: nexora-a607f)
VITE_FIREBASE_PROJECT_ID="nexora-a607f"
VITE_FIREBASE_AUTH_DOMAIN="nexora-a607f.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="nexora-a607f.firebasestorage.app"
VITE_FIREBASE_DATABASE_ID="(default)"

# Paste your Web App credentials from Firebase Console -> Project Settings -> General -> Your apps:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Optional WebRTC TURN Infrastructure (Defaults to Google STUN at ₹0 budget)
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Optional Gemini AI API Key
GEMINI_API_KEY=""
