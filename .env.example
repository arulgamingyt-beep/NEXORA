# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env.local` for local production testing or set in hosting platform (Vercel / Firebase)
# ==============================================================================

# Public Application URL (Used for invite links and OAuth redirects)
VITE_APP_URL="https://nexora-terminal.vercel.app"
APP_URL="https://nexora-terminal.vercel.app"

# Optional Gemini AI API Key (Injected securely at runtime if utilizing AI Studio)
GEMINI_API_KEY=""

# Firebase Configuration (Optional override; defaults to firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
